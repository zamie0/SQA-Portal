                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">int c = (vars.get(&apos;AI_BM_READ_COUNT&apos;) ?: &apos;0&apos;) as int
vars.put(&apos;AI_BM_READ_COUNT&apos;, String.valueOf(c + 1))</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract BM AI Done Flag" enabled="true">
                  <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                  <stringProp name="RegexExtractor.refname">AI_BM_DONE</stringProp>
                  <stringProp name="RegexExtractor.regex">&quot;type&quot;:&quot;(done)&quot;</stringProp>
                  <stringProp name="RegexExtractor.template">$1$</stringProp>
                  <stringProp name="RegexExtractor.default">false</stringProp>
                  <stringProp name="RegexExtractor.match_number">1</stringProp>
                  <stringProp name="Scope.variable"></stringProp>
                  <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                </RegexExtractor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log BM AI Tutor Response" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">String response = prev.getResponseDataAsString() ?: &apos;&apos;
String trimmed = response.trim()
String msg = prev.getResponseMessage() ?: &apos;&apos;
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_BM_NEED_PONG&apos;, &apos;false&apos;)
    vars.put(&apos;AI_BM_RETRY_NEEDED&apos;, &apos;true&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.warn(&apos;AI_TUTOR_BM_SOCKET_RESET | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | reason=&apos; + msg)
    return
}
vars.put(&apos;AI_BM_NEED_PONG&apos;, trimmed == &apos;2&apos; ? &apos;true&apos; : &apos;false&apos;)
if (trimmed.startsWith(&apos;41&apos;)) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_BM_RETRY_NEEDED&apos;, &apos;true&apos;)
    return
}
if (trimmed == &apos;2&apos;) {
    return
}
if ((vars.get(&apos;AI_BM_DONE&apos;) ?: &apos;false&apos;) == &apos;done&apos; &amp;&amp; (vars.get(&apos;AI_BM_DONE_RECORDED&apos;) ?: &apos;false&apos;) != &apos;true&apos;) {
    int done = (vars.get(&apos;AI_BM_DONE_COUNT&apos;) ?: &apos;0&apos;) as int
    vars.put(&apos;AI_BM_DONE_COUNT&apos;, String.valueOf(done + 1))
    vars.put(&apos;AI_BM_DONE_RECORDED&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_RETRY_NEEDED&apos;, &apos;false&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.info(&apos;AI_TUTOR_BM_RESPONSE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=done&apos;)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
