            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Log Math Question Sent" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">if ((vars.get(&apos;AI_MATH_LAST_SEND_OK&apos;) ?: &apos;false&apos;) != &apos;true&apos;) {
    log.warn(&apos;AI_TUTOR_MATH_SENT_SKIPPED | user=&apos; + (vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;) + &apos; | question_no=&apos; + (vars.get(&apos;question_no&apos;) ?: &apos;&apos;))
    return
}

int current = (vars.get(&apos;AI_MATH_SENT_COUNT&apos;) ?: &apos;0&apos;) as int
current++
vars.put(&apos;AI_MATH_SENT_COUNT&apos;, String.valueOf(current))

String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
String qno = vars.get(&apos;question_no&apos;) ?: String.valueOf(current)
String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
String threadName = ctx.getThread().getThreadName()

log.info(&apos;AI_TUTOR_MATH_SENT | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q)</stringProp>
