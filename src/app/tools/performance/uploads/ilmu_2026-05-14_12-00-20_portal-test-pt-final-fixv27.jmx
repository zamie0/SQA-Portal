              <stringProp name="WhileController.condition">${__groovy((vars.get(&apos;AI_BM_DONE&apos;) ?: &apos;false&apos;) != &apos;done&apos; &amp;&amp; ((vars.get(&apos;AI_BM_READ_COUNT&apos;) ?: &apos;0&apos;) as int) &lt; 500)}</stringProp>
            </WhileController>
            <hashTree>
              <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read BM AI Tutor Chunk" enabled="true">
