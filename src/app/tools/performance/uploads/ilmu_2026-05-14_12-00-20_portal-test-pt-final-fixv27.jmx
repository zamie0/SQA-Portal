              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="WS Send Math Question" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def list = vars.getObject(&quot;questions_math&quot;)
def index = (vars.get(&quot;qIndex_math&quot;) ?: &quot;0&quot;) as int

if (!(list instanceof List) || index &gt;= list.size()) {
    throw new IllegalStateException(&quot;No Math question row available at index &quot; + index)
}

String line = list[index] as String
String[] row = line.split(&quot;,&quot;, 3)
if (row.length &lt; 3) {
    throw new IllegalStateException(&quot;Invalid Math CSV row: &quot; + line)
}

String question = row[2].trim()
if (question.startsWith(&apos;&quot;&apos;) &amp;&amp; question.endsWith(&apos;&quot;&apos;) &amp;&amp; question.length() &gt;= 2) {
    question = question.substring(1, question.length() - 1).replace(&apos;&quot;&quot;&apos;, &apos;&quot;&apos;)
}

vars.put(&quot;question_no&quot;, row[0].trim())
vars.put(&quot;subject&quot;, row[1].trim())
vars.put(&quot;question&quot;, question)
vars.put(&quot;AI_QUESTION_JSON&quot;, groovy.json.JsonOutput.toJson(question))
vars.put(&quot;AI_MATH_DONE&quot;, &quot;false&quot;)
vars.put(&quot;AI_MATH_READ_COUNT&quot;, &quot;0&quot;)
vars.put(&quot;AI_MATH_NEED_PONG&quot;, &quot;false&quot;)
vars.put(&quot;AI_MATH_LAST_SEND_OK&quot;, &quot;false&quot;)
vars.put(&quot;AI_MATH_RETRY_NEEDED&quot;, &quot;false&quot;)
vars.put(&quot;AI_MATH_RETRY_SEND_OK&quot;, &quot;false&quot;)
vars.put(&quot;AI_MATH_DONE_RECORDED&quot;, &quot;false&quot;)

vars.put(&quot;qIndex_math&quot;, (index + 1).toString())</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log Math Send Connection Error" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">String msg = prev.getResponseMessage() ?: &apos;&apos;
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_MATH_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_MATH_LAST_SEND_OK&apos;, &apos;false&apos;)
    vars.put(&apos;AI_MATH_RETRY_NEEDED&apos;, &apos;true&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.error(&apos;AI_TUTOR_MATH_RESPONSE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=error | reason=&apos; + msg)
} else {
    vars.put(&apos;AI_MATH_LAST_SEND_OK&apos;, &apos;true&apos;)
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
