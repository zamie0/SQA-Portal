                <stringProp name="requestData">{&quot;type&quot;:&quot;start&quot;,&quot;payload&quot;:{&quot;subjectId&quot;:&quot;2&quot;,&quot;messages&quot;:${AI_QUESTION_JSON},&quot;mediaId&quot;:[],&quot;assistantType&quot;:&quot;tutor&quot;,&quot;interactionType&quot;:&quot;text&quot;}}</stringProp>
