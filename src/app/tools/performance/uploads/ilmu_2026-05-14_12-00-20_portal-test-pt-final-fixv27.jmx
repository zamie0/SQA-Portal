                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log Math AI Tutor Response" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">String response = prev.getResponseDataAsString() ?: &apos;&apos;
String trimmed = response.trim()
String msg = prev.getResponseMessage() ?: &apos;&apos;
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_MATH_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_MATH_NEED_PONG&apos;, &apos;false&apos;)
    vars.put(&apos;AI_MATH_RETRY_NEEDED&apos;, &apos;true&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.warn(&apos;AI_TUTOR_MATH_SOCKET_RESET | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | reason=&apos; + msg)
    return
}
vars.put(&apos;AI_MATH_NEED_PONG&apos;, trimmed == &apos;2&apos; ? &apos;true&apos; : &apos;false&apos;)
if (trimmed.startsWith(&apos;41&apos;)) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_MATH_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_MATH_RETRY_NEEDED&apos;, &apos;true&apos;)
    return
}
if (trimmed == &apos;2&apos;) {
    return
}
if ((vars.get(&apos;AI_MATH_DONE&apos;) ?: &apos;false&apos;) == &apos;done&apos; &amp;&amp; (vars.get(&apos;AI_MATH_DONE_RECORDED&apos;) ?: &apos;false&apos;) != &apos;true&apos;) {
    int done = (vars.get(&apos;AI_MATH_DONE_COUNT&apos;) ?: &apos;0&apos;) as int
    vars.put(&apos;AI_MATH_DONE_COUNT&apos;, String.valueOf(done + 1))
    vars.put(&apos;AI_MATH_DONE_RECORDED&apos;, &apos;true&apos;)
    vars.put(&apos;AI_MATH_RETRY_NEEDED&apos;, &apos;false&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.info(&apos;AI_TUTOR_MATH_RESPONSE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=done&apos;)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
