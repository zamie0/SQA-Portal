                  <stringProp name="WhileController.condition">${__groovy((vars.get(&apos;AI_MATH_DONE&apos;) ?: &apos;false&apos;) != &apos;done&apos; &amp;&amp; ((vars.get(&apos;AI_MATH_READ_COUNT&apos;) ?: &apos;0&apos;) as int) &lt; 500)}</stringProp>
