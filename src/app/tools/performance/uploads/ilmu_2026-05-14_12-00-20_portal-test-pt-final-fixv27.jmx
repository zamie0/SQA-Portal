            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract first option per question" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
if (!body) return

def json = new JsonSlurper().parseText(body)
def questions = (json?.data?.questions instanceof List) ? json.data.questions : []

int idx = 0
questions.each { q -&gt;
    idx++
    def opts = (q?.options instanceof List) ? q.options : []
    def first = (opts &amp;&amp; opts.size() &gt; 0) ? opts[0] : null
    def firstId = (first?.id != null) ? first.id.toString() : &apos;&apos;
    vars.put(&apos;optionId_&apos; + idx, firstId)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Display Assessment Answer" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
String threadName = ctx.getThread().getThreadName()
String iteration = vars.getIteration() as String

int totalQuestions = 26
StringBuilder sb = new StringBuilder()

// ðŸ”¹ Add header for each thread/user iteration
sb.append(&apos;\n=== THREAD=&apos;).append(threadName)
  .append(&apos; | USER=&apos;).append(user)
  .append(&apos; | ITERATION=&apos;).append(iteration)
  .append(&apos; ===\n&apos;)

for (int i = 1; i &lt;= totalQuestions; i++) {
    String qId = vars.get(&apos;questionId_&apos; + i) ?: &apos;&apos;
    String optId = vars.get(&apos;optionId_&apos; + i) ?: &apos;&apos;

    String line = &apos;Q&apos; + i +
            (qId ? (&apos; | question_id=&apos; + qId) : &apos;&apos;) +
            (optId ? (&apos; | option_id=&apos; + optId) : &apos;&apos;)

    // âœ… Each question on its own line
    sb.append(line).append(&apos;\n&apos;)
}

// Optional spacing between users/threads
sb.append(&apos;\n&apos;)

log.info(sb.toString())

SampleResult.setSuccessful(true)
SampleResult.setResponseCodeOK()
SampleResult.setResponseMessage(&apos;Displayed 26 answers per iteration&apos;)
SampleResult.setResponseData(sb.toString().getBytes(&apos;UTF-8&apos;))</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Sampler>
            <hashTree/>
            <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="PUT Submit Assessment Answers (26)" enabled="true">
              <stringProp name="LoopController.loops">26</stringProp>
              <boolProp name="LoopController.continue_forever">false</boolProp>
            </LoopController>
            <hashTree>
              <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Assessment Answer Counter" enabled="true">
                <stringProp name="CounterConfig.start">1</stringProp>
                <stringProp name="CounterConfig.end">26</stringProp>
                <stringProp name="CounterConfig.incr">1</stringProp>
                <stringProp name="CounterConfig.name">ASSESS_IDX</stringProp>
                <stringProp name="CounterConfig.format"></stringProp>
                <boolProp name="CounterConfig.per_user">true</boolProp>
                <boolProp name="CounterConfig.resetOnThreadGroupIteration">true</boolProp>
              </CounterConfig>
              <hashTree/>
              <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Answer Payloads" enabled="true">
                <stringProp name="filename">C:/PT Test Fix/learning_assessment_answers.csv</stringProp>
                <stringProp name="fileEncoding">UTF-8</stringProp>
                <stringProp name="variableNames">csv_questionId,csv_selectedOptionIds,csv_isSkipped,csv_timeTakenToAnswer</stringProp>
                <boolProp name="ignoreFirstLine">true</boolProp>
                <stringProp name="delimiter">,</stringProp>
                <boolProp name="quotedData">false</boolProp>
                <boolProp name="recycle">false</boolProp>
                <boolProp name="stopThread">false</boolProp>
                <stringProp name="shareMode">shareMode.all</stringProp>
              </CSVDataSet>
              <hashTree/>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Assessment PUT payload" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def idx = (vars.get(&apos;ASSESS_IDX&apos;) ?: &apos;1&apos;) as int

def uqId = vars.get(&apos;userQuestionnaireId&apos;)
if (!uqId) uqId = vars.get(&apos;userQuestionnaireStartId&apos;)
uqId = (uqId ?: &apos;&apos;).toString().trim()
vars.put(&apos;ASSESS_UQ_ID&apos;, uqId)

if (!uqId) {
    throw new IllegalStateException(&apos;Missing userQuestionnaireId/userQuestionnaireStartId (cannot call /learning/v1/user-questionnaires/{id}/answers)&apos;)
}

// Use API-extracted questionId, take selectedOptionIds from CSV, plus isSkipped and timeTakenToAnswer
def qId = vars.get(&apos;questionId_&apos; + idx) ?: &apos;&apos;
def csvOptId = vars.get(&apos;csv_selectedOptionIds&apos;) ?: &apos;7&apos;
def isSkipped = vars.get(&apos;csv_isSkipped&apos;) ?: &apos;false&apos;
def timeTaken = vars.get(&apos;csv_timeTakenToAnswer&apos;) ?: &apos;76&apos;

if (!qId) {
    throw new IllegalStateException(&apos;Missing questionId_&apos; + idx + &apos; (cannot build PUT answer payload)&apos;)
}

def body = &apos;{&quot;questionId&quot;:&quot;&apos; + qId + &apos;&quot;,&quot;selectedOptionIds&quot;:[&quot;&apos; + csvOptId + &apos;&quot;],&quot;isSkipped&quot;:&apos; + isSkipped + &apos;,&quot;timeTakenToAnswer&quot;:&apos; + timeTaken + &apos;}&apos;
vars.put(&apos;ASSESS_ANSWER_BODY&apos;, body)</stringProp>
