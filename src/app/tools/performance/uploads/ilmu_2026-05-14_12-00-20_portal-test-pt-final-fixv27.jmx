              <hashTree>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log BI Retry Send Result" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">String msg = prev.getResponseMessage() ?: &apos;&apos;
String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
String threadName = ctx.getThread().getThreadName()
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BI_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_BI_RETRY_SEND_OK&apos;, &apos;false&apos;)
    log.error(&apos;AI_TUTOR_BI_RETRY | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=error | reason=&apos; + msg)
} else {
    vars.put(&apos;AI_BI_RETRY_SEND_OK&apos;, &apos;true&apos;)
    log.info(&apos;AI_TUTOR_BI_RETRY | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=resent&apos;)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
