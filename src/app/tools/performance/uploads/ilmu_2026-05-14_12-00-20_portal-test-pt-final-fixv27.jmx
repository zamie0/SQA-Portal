            <stringProp name="script">vars.put(&apos;AI_BM_SENT_COUNT&apos;,&apos;0&apos;)
vars.put(&apos;AI_BM_DONE_COUNT&apos;,&apos;0&apos;)
log.info(&apos;AI_TUTOR_BM_VERIFY_INIT | user=&apos; + (vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;))
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load and Randomize BM" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def file = new File(&quot;C:/PT Test Fix/BM_SPM.csv&quot;)
def lines = file.readLines()

lines.remove(0) // remove header

Collections.shuffle(lines)

// take 5 random questions
def selected = lines.take(5)

vars.putObject(&quot;questions_bm&quot;, selected)
vars.put(&quot;qIndex_bm&quot;, &quot;0&quot;)</stringProp>
          </JSR223Sampler>
