            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log Assessment Selected Options" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
def uqId = vars.get(&apos;userQuestionnaireId&apos;) ?: vars.get(&apos;ASSESS_UQ_ID&apos;) ?: &apos;&apos;
def threadName = ctx.getThread().getThreadName()

def body = prev.getResponseDataAsString()
if (!body) {
    log.warn(&apos;LEARNING_ASSESSMENT_ANSWERS_EMPTY | thread=&apos; + threadName + &apos; | user=&apos; + user)
    return
}

log.info(&apos;LEARNING_ASSESSMENT_RAW_RESPONSE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | body=&apos; + (body.length() &gt; 1000 ? body.substring(0, 1000) + &apos;...[truncated]&apos; : body))

def json
try {
    json = new JsonSlurper().parseText(body)
} catch (Exception e) {
    log.error(&apos;LEARNING_ASSESSMENT_ANSWERS_PARSE_ERROR&apos;, e)
    return
}

def answers = json?.data
if (answers instanceof Map) {
    answers = answers?.answers ?: []
}
if (!(answers instanceof List)) {
    log.warn(&apos;LEARNING_ASSESSMENT_ANSWERS_NOT_LIST | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | dataType=&apos; + (answers?.getClass()?.getSimpleName() ?: &apos;null&apos;))
    return
}

StringBuilder sb = new StringBuilder()
sb.append(&apos;LEARNING_ASSESSMENT_SELECTED_OPTIONS | thread=&apos;).append(threadName)
  .append(&apos; | user=&apos;).append(user)
  .append((uqId ? (&apos; | userQuestionnaireId=&apos; + uqId) : &apos;&apos;))
  .append(&apos;\\n&apos;)

answers.eachWithIndex { answer, idx -&gt;
    def qId = answer?.questionId ?: answer?.id ?: &apos;UNKNOWN&apos;
    def detail = answer?.selectedOptionDetails ?: []
    def selectedLabel = detail.collect { d -&gt; d?.optionText ?: d?.optionCode ?: d?.id }.join(&apos; | &apos;)
    if (!selectedLabel) {
        selectedLabel = (answer?.selectedOptions ?: []).toString()
    }
    sb.append(&apos;Q&apos; + (idx + 1) + &apos; | questionId=&apos; + qId + &apos; | selected=&apos; + selectedLabel + &apos;\\n&apos;)
}

log.info(sb.toString())

def totalAnswered = answers.size()
def status = (totalAnswered == 26) ? &apos;DONE&apos; : &apos;INCOMPLETE&apos;
log.info(&apos;LEARNING_ASSESSMENT_STATUS | thread=&apos; + threadName + &apos; | user=&apos; + user + (uqId ? (&apos; | userQuestionnaireId=&apos; + uqId) : &apos;&apos;) + &apos; | answered=&apos; + totalAnswered + &apos; | total=26 | status=&apos; + status)

vars.put(&apos;LEARNING_ASSESSMENT_SELECTED_OPTIONS&apos;, sb.toString())</stringProp>
