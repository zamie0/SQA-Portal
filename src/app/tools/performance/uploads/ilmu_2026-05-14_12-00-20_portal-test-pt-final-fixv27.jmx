                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">def idx = vars.get(&apos;ASSESS_IDX&apos;) ?: &apos;unknown&apos;
def qId = vars.get(&apos;questionId_&apos; + idx) ?: &apos;MISSING_QID&apos;
def selectedOptId = vars.get(&apos;csv_selectedOptionIds&apos;) ?: (vars.get(&apos;optionId_&apos; + idx) ?: &apos;MISSING_OPTION&apos;)
def isSkipped = vars.get(&apos;csv_isSkipped&apos;) ?: &apos;false&apos;
def timeTaken = vars.get(&apos;csv_timeTakenToAnswer&apos;) ?: &apos;76&apos;
def code = prev.getResponseCode()
def status = (code in [&apos;200&apos;,&apos;204&apos;]) ? &apos;SUBMITTED&apos; : &apos;FAILED&apos;
def user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
def threadName = ctx.getThread().getThreadName()
log.info(&apos;LEARNING_ASSESSMENT_SUBMIT | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | idx=&apos; + idx + &apos; | questionId=&apos; + qId + &apos; | selectedOptionId=&apos; + selectedOptId + &apos; | isSkipped=&apos; + isSkipped + &apos; | timeTaken=&apos; + timeTaken + &apos; | status=&apos; + status + &apos; | http=&apos; + code)
vars.put(&apos;LEARNING_ASSESSMENT_LAST_SUBMIT_STATUS&apos;, status)</stringProp>
