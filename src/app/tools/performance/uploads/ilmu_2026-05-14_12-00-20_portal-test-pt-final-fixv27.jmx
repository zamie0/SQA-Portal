            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def file = new File(&quot;C:/PT Test Fix/Sejarah_SPM.csv&quot;)
def lines = file.readLines()

lines.remove(0) // remove header

Collections.shuffle(lines)

// take 5 random questions
def selected = lines.take(5)

vars.putObject(&quot;questions_sejarah&quot;, selected)
vars.put(&quot;qIndex_sejarah&quot;, &quot;0&quot;)</stringProp>
