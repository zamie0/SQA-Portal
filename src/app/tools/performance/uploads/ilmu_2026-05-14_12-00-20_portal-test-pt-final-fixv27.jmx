              <hashTree>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log BM Retry Send Result" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">String msg = prev.getResponseMessage() ?: &apos;&apos;
String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
String threadName = ctx.getThread().getThreadName()
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_BM_RETRY_SEND_OK&apos;, &apos;false&apos;)
    log.error(&apos;AI_TUTOR_BM_RETRY | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=error | reason=&apos; + msg)
} else {
    vars.put(&apos;AI_BM_RETRY_SEND_OK&apos;, &apos;true&apos;)
    log.info(&apos;AI_TUTOR_BM_RETRY | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=resent&apos;)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Read BM Retry Response If Resent" enabled="true">
                <stringProp name="IfController.condition">${__groovy((vars.get(&apos;AI_BM_RETRY_SEND_OK&apos;) ?: &apos;false&apos;) == &apos;true&apos;)}</stringProp>
                <boolProp name="IfController.evaluateAll">false</boolProp>
                <boolProp name="IfController.useExpression">true</boolProp>
              </IfController>
              <hashTree>
                <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="WS Read BM Retry Stream Until Done (Max 500)" enabled="true">
                  <stringProp name="WhileController.condition">${__groovy((vars.get(&apos;AI_BM_DONE&apos;) ?: &apos;false&apos;) != &apos;done&apos; &amp;&amp; ((vars.get(&apos;AI_BM_READ_COUNT&apos;) ?: &apos;0&apos;) as int) &lt; 500)}</stringProp>
                </WhileController>
                <hashTree>
                  <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS Read BM Retry Chunk" enabled="true">
                    <boolProp name="createNewConnection">false</boolProp>
                    <stringProp name="TestPlan.comments">Read streaming delta or done frame after retry</stringProp>
                    <stringProp name="server"></stringProp>
                    <stringProp name="port">80</stringProp>
                    <stringProp name="path"></stringProp>
                    <boolProp name="binaryPayload">false</boolProp>
                    <boolProp name="optional">true</boolProp>
                    <stringProp name="readTimeout">60000</stringProp>
                    <stringProp name="dataType">Text</stringProp>
                    <boolProp name="TLS">false</boolProp>
                    <stringProp name="connectTimeout">20000</stringProp>
                  </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
                  <hashTree>
                    <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Increment BM Retry Read Count" enabled="true">
                      <stringProp name="scriptLanguage">groovy</stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="filename"></stringProp>
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="script">int c = (vars.get(&apos;AI_BM_READ_COUNT&apos;) ?: &apos;0&apos;) as int
vars.put(&apos;AI_BM_READ_COUNT&apos;, String.valueOf(c + 1))</stringProp>
                    </JSR223PreProcessor>
                    <hashTree/>
                    <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract BM AI Done Flag Retry" enabled="true">
                      <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                      <stringProp name="RegexExtractor.refname">AI_BM_DONE</stringProp>
                      <stringProp name="RegexExtractor.regex">&quot;type&quot;:&quot;(done)&quot;</stringProp>
                      <stringProp name="RegexExtractor.template">$1$</stringProp>
                      <stringProp name="RegexExtractor.default">false</stringProp>
                      <stringProp name="RegexExtractor.match_number">1</stringProp>
                      <stringProp name="Scope.variable"></stringProp>
                      <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                    </RegexExtractor>
                    <hashTree/>
                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log BM Retry AI Tutor Response" enabled="true">
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="filename"></stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="script">String response = prev.getResponseDataAsString() ?: &apos;&apos;
String trimmed = response.trim()
String msg = prev.getResponseMessage() ?: &apos;&apos;
if (!prev.isSuccessful()) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_DONE&apos;, &apos;done&apos;)
    vars.put(&apos;AI_BM_NEED_PONG&apos;, &apos;false&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.warn(&apos;AI_TUTOR_BM_RETRY_RESET | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | reason=&apos; + msg)
    return
}
vars.put(&apos;AI_BM_NEED_PONG&apos;, trimmed == &apos;2&apos; ? &apos;true&apos; : &apos;false&apos;)
if (trimmed.startsWith(&apos;41&apos;)) {
    vars.put(&apos;AI_TUTOR_RECONNECT&apos;, &apos;true&apos;)
    vars.put(&apos;AI_BM_DONE&apos;, &apos;done&apos;)
    return
}
if (trimmed == &apos;2&apos;) {
    return
}
if ((vars.get(&apos;AI_BM_DONE&apos;) ?: &apos;false&apos;) == &apos;done&apos; &amp;&amp; (vars.get(&apos;AI_BM_DONE_RECORDED&apos;) ?: &apos;false&apos;) != &apos;true&apos;) {
    int done = (vars.get(&apos;AI_BM_DONE_COUNT&apos;) ?: &apos;0&apos;) as int
    vars.put(&apos;AI_BM_DONE_COUNT&apos;, String.valueOf(done + 1))
    vars.put(&apos;AI_BM_DONE_RECORDED&apos;, &apos;true&apos;)
    String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
    String qno = vars.get(&apos;question_no&apos;) ?: &apos;&apos;
    String q = vars.get(&apos;question&apos;) ?: &apos;&apos;
    String threadName = ctx.getThread().getThreadName()
    log.info(&apos;AI_TUTOR_BM_RESPONSE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | question_no=&apos; + qno + &apos; | question=&apos; + q + &apos; | status=done_retry&apos;)
}</stringProp>
                      <stringProp name="scriptLanguage">groovy</stringProp>
                    </JSR223PostProcessor>
                    <hashTree/>
                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Refresh Access Token On BM Retry Disconnect" enabled="true">
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="filename">C:/PT Test Fix/refresh_access_token_if_needed.groovy</stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="script"></stringProp>
                      <stringProp name="scriptLanguage">groovy</stringProp>
                    </JSR223PostProcessor>
                    <hashTree/>
                    <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Send BM Retry Pong If Ping" enabled="true">
                      <stringProp name="IfController.condition">${__groovy((vars.get(&apos;AI_BM_NEED_PONG&apos;) ?: &apos;false&apos;) == &apos;true&apos;)}</stringProp>
                      <boolProp name="IfController.evaluateAll">false</boolProp>
                      <boolProp name="IfController.useExpression">true</boolProp>
                    </IfController>
                    <hashTree>
                      <eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler" testname="WS Send BM Retry Pong" enabled="true">
                        <boolProp name="createNewConnection">false</boolProp>
                        <boolProp name="TLS">true</boolProp>
                        <stringProp name="server"></stringProp>
                        <stringProp name="port">80</stringProp>
                        <stringProp name="path"></stringProp>
                        <stringProp name="requestData">3</stringProp>
                        <boolProp name="binaryPayload">false</boolProp>
                        <stringProp name="connectTimeout">20000</stringProp>
                        <stringProp name="payloadType">Text</stringProp>
                        <boolProp name="loadDataFromFile">false</boolProp>
                        <stringProp name="dataFile"></stringProp>
                      </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
                      <hashTree/>
                    </hashTree>
                  </hashTree>
                </hashTree>
              </hashTree>
            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verify 5 BM Questions Sent" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">int sent = (vars.get(&apos;AI_BM_SENT_COUNT&apos;) ?: &apos;0&apos;) as int
int done = (vars.get(&apos;AI_BM_DONE_COUNT&apos;) ?: &apos;0&apos;) as int
String user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
String threadName = ctx.getThread().getThreadName()

if (done != 5) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;500&apos;)
    SampleResult.setResponseMessage(&apos;Expected 5 BM questions completed but got done=&apos; + done + &apos;, sent=&apos; + sent)
    SampleResult.setResponseData((&apos;AI_TUTOR_BM_VERIFY_FAIL | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | done=&apos; + done + &apos; | sent=&apos; + sent).getBytes(&apos;UTF-8&apos;))
    log.error(&apos;AI_TUTOR_BM_VERIFY_FAIL | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | done=&apos; + done + &apos; | sent=&apos; + sent)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessage(&apos;Verified 5 BM questions completed&apos;)
    SampleResult.setResponseData((&apos;AI_TUTOR_BM_VERIFY_PASS | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | done=&apos; + done + &apos; | sent=&apos; + sent).getBytes(&apos;UTF-8&apos;))
    log.info(&apos;AI_TUTOR_BM_VERIFY_PASS | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | done=&apos; + done + &apos; | sent=&apos; + sent)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time After BM Questions" enabled="true">
            <stringProp name="ConstantTimer.delay">100</stringProp>
          </ConstantTimer>
          <hashTree/>
          <eu.luminis.jmeter.wssampler.CloseWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.CloseWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.CloseWebSocketSampler" testname="WS Close AI Tutor Connection" enabled="true">
            <stringProp name="TestPlan.comments">close websocket connection</stringProp>
            <stringProp name="statusCode">1000</stringProp>
            <stringProp name="readTimeout">6000</stringProp>
          </eu.luminis.jmeter.wssampler.CloseWebSocketSampler>
          <hashTree/>
        </hashTree>
