          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Log Assessment Completion &amp; Summary" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def uqId = vars.get(&apos;userQuestionnaireId&apos;) ?: vars.get(&apos;ASSESS_UQ_ID&apos;) ?: &apos;MISSING&apos;
def uqStart = vars.get(&apos;userQuestionnaireStartId&apos;) ?: &apos;MISSING&apos;
def user = vars.get(&apos;email&apos;) ?: &apos;UNKNOWN&apos;
def threadName = ctx.getThread().getThreadName()

// Log variables for debugging
log.info(&apos;LEARNING_ASSESSMENT_VARS | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | userQuestionnaireId=&apos; + uqId + &apos; | userQuestionnaireStartId=&apos; + uqStart)

// Build summary of all answered questions from the Display Assessment Answer log that was already generated
// The Display Assessment Answer sampler already logged all 26 Q/option pairs.
// Here we just log the completion status.
log.info(&apos;LEARNING_ASSESSMENT_COMPLETE | thread=&apos; + threadName + &apos; | user=&apos; + user + &apos; | userQuestionnaireId=&apos; + uqId + &apos; | total_questions=26 | status=ALL_ANSWERS_SUBMITTED&apos;)

SampleResult.setSuccessful(true)
SampleResult.setResponseCodeOK()
SampleResult.setResponseMessage(&apos;Assessment complete - all 26 answers submitted&apos;)</stringProp>
