    &quot;${QUIZ_SELECTED_OPTION_ID}&quot;&#xd;
  ]&#xd;
}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
                <stringProp name="HTTPSampler.domain">ilmu-dev.tmrnd.dev</stringProp>
